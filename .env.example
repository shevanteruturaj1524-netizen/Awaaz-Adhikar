# AWAAZ ADHIKAR - ENVIRONMENT CONFIGURATION (SAMPLE / PLACEHOLDER TEMPLATE)
# Copy this file to .env and populate your actual environment secrets.
# NEVER commit real API keys, tokens, or credentials to version control.

# ----------------------------------------------------------------
# SerpApi Configuration (Live Indian Government Source Search)
# Get key from: https://serpapi.com/
# ----------------------------------------------------------------
SERPAPI_API_KEY=your_serpapi_api_key_here

# ----------------------------------------------------------------
# System Operation Mode
# Set DEMO_MODE to true to enable high-resilience fallback with mock OTP (123456)
# Set to false for live production with strict SMS OTP verification
# ----------------------------------------------------------------
DEMO_MODE=true

# ----------------------------------------------------------------
# Cloud AI / Speech-to-Text / TTS Providers (Optional)
# If omitted, system seamlessly uses built-in browser speech synthesis and Google STT
# ----------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ----------------------------------------------------------------
# SMS OTP Configuration (Required for live citizen verification SMS delivery)
# ----------------------------------------------------------------

# Option 1: Fast2SMS (India — recommended for Indian mobile numbers)
# Get key from: https://www.fast2sms.com/
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Option 2: Twilio (International / Pan-India)
# Get credentials from: https://www.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# Option 3: Custom HTTP SMS Gateway
# Must accept POST with JSON {"to": "...", "message": "..."}
SMS_GATEWAY_URL=https://your-sms-gateway.example.gov.in/api/v1/send
SMS_GATEWAY_API_KEY=your_gateway_bearer_token_here

# Server Host & Port
HOST=127.0.0.1
PORT=8000
